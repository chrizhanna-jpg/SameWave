# Copy these variable NAMES into Render → your api-server service → Environment.
# Values come from Clerk Dashboard, Neon, OpenAI, etc. Do not commit real secrets.

PORT=8787
DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
BACKFILL_ADMIN_TOKEN=
# Optional. All five must be set or photo bytes stay in Postgres.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
PHOTO_RETENTION_DAYS=90
# REQUIRED for Play update notifications — copy these to Render Environment.
# Without them, /api/public/app-config falls back to versionCode 28 until a rebuild bundles config.
ANDROID_LATEST_VERSION_CODE=43
ANDROID_LATEST_VERSION_NAME=1.3.15
ANDROID_UPDATE_MESSAGE=A new version of SameWave is ready with improved photo matching — update from the Play Store for the best experience.
